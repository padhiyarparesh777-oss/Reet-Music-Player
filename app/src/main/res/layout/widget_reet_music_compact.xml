<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:scaleType="centerCrop"
        android:background="@drawable/widget_art_bg"
        android:contentDescription="Current song artwork" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose a song"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans"
            android:maxLines="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Reet Music Player"
            android:textColor="#BFFFFFFF"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:src="@drawable/ic_widget_previous"
                android:tint="#F5FFFFFF"
                android:contentDescription="Previous song" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_play_button_bg"
                android:padding="8dp"
                android:src="@drawable/ic_widget_play"
                android:tint="#FFFFFFFF"
                android:contentDescription="Play or pause" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:src="@drawable/ic_widget_next"
                android:tint="#F5FFFFFF"
                android:contentDescription="Next song" />

            <ImageButton
                android:id="@+id/widget_favourite"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:src="@drawable/ic_widget_favorite"
                android:tint="#FFFFFFFF"
                android:contentDescription="Toggle favourite" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
